const db = require('./database');

const TOKEN = process.env.DISCORD_BOT_TOKEN || '';
const OWNER_IDS = (process.env.DISCORD_OWNER_IDS || '')
    .split(',')
    .map(s => s.trim())
    .filter(Boolean);
const GUILD_ID = process.env.DISCORD_GUILD_ID || '';

let client = null;
let started = false;
let lastError = null;
let readyAt = null;

function isOwner(userId) {
    if (!OWNER_IDS.length) return true; // if not configured, allow anyone in the guild (change this if you want strict mode)
    return OWNER_IDS.includes(String(userId));
}

function getData() {
    return db.getData();
}

async function persist() {
    if (typeof db.save === 'function') await db.save();
}

function statusSnapshot() {
    const data = getData();
    return {
        running: !!(client && client.isReady && client.isReady()),
        readyAt,
        lastError,
        user: client && client.user ? client.user.tag : null,
        guilds: client && client.guilds ? client.guilds.cache.size : 0,
        maintenanceMode: !!(data && data.maintenanceMode),
        pending: (data.pendingPlaces || []).length,
        keys: (data.keys || []).length,
        creators: (data.whitelist && data.whitelist.creators || []).length,
        places: (data.whitelist && data.whitelist.places || []).length
    };
}

async function start() {
    if (started) return statusSnapshot();
    if (!TOKEN) {
        lastError = 'DISCORD_BOT_TOKEN not set';
        console.warn('[discord-bot]', lastError);
        return statusSnapshot();
    }

    let Discord;
    try {
        Discord = require('discord.js');
    } catch (e) {
        lastError = 'discord.js not installed — run: npm install discord.js';
        console.warn('[discord-bot]', lastError);
        return statusSnapshot();
    }

    const {
        Client,
        GatewayIntentBits,
        REST,
        Routes,
        SlashCommandBuilder,
        EmbedBuilder,
        PermissionFlagsBits
    } = Discord;

    client = new Client({
        intents: [GatewayIntentBits.Guilds]
    });

    const commands = [
        new SlashCommandBuilder()
            .setName('wl-status')
            .setDescription('Whitelist system status'),
        new SlashCommandBuilder()
            .setName('wl-pending')
            .setDescription('List pending game requests'),
        new SlashCommandBuilder()
            .setName('wl-approve')
            .setDescription('Approve a pending place')
            .addStringOption(o => o.setName('place_id').setDescription('Place ID').setRequired(true))
            .addStringOption(o => o.setName('key').setDescription('License key (optional)')),
        new SlashCommandBuilder()
            .setName('wl-reject')
            .setDescription('Reject / remove a pending place')
            .addStringOption(o => o.setName('place_id').setDescription('Place ID').setRequired(true)),
        new SlashCommandBuilder()
            .setName('wl-keys')
            .setDescription('List system keys'),
        new SlashCommandBuilder()
            .setName('wl-add-key')
            .setDescription('Register a new system key')
            .addStringOption(o => o.setName('key').setDescription('Key name').setRequired(true))
            .addBooleanOption(o => o.setName('all_access').setDescription('Is ALL access key?')),
        new SlashCommandBuilder()
            .setName('wl-freeze-key')
            .setDescription('Freeze / unfreeze a system key')
            .addStringOption(o => o.setName('key').setDescription('Key name').setRequired(true)),
        new SlashCommandBuilder()
            .setName('wl-maintenance')
            .setDescription('Toggle maintenance mode')
            .addStringOption(o =>
                o.setName('state').setDescription('on / off').setRequired(true)
                    .addChoices({ name: 'on', value: 'on' }, { name: 'off', value: 'off' })
            ),
        new SlashCommandBuilder()
            .setName('wl-stats')
            .setDescription('Usage statistics'),
        new SlashCommandBuilder()
            .setName('wl-lookup')
            .setDescription('Lookup a creator or place on the whitelist')
            .addStringOption(o =>
                o.setName('type').setDescription('creators or places').setRequired(true)
                    .addChoices({ name: 'creators', value: 'creators' }, { name: 'places', value: 'places' })
            )
            .addStringOption(o => o.setName('id').setDescription('Roblox ID').setRequired(true))
    ].map(c => c.toJSON());

    client.once('ready', async () => {
        readyAt = new Date().toISOString();
        lastError = null;
        console.log(`[discord-bot] Logged in as ${client.user.tag}`);

        try {
            const rest = new REST({ version: '10' }).setToken(TOKEN);
            if (GUILD_ID) {
                await rest.put(Routes.applicationGuildCommands(client.user.id, GUILD_ID), { body: commands });
                console.log('[discord-bot] Guild slash commands registered');
            } else {
                await rest.put(Routes.applicationCommands(client.user.id), { body: commands });
                console.log('[discord-bot] Global slash commands registered (can take up to 1h)');
            }
        } catch (e) {
            lastError = 'Command register failed: ' + (e.message || e);
            console.error('[discord-bot]', lastError);
        }
    });

    client.on('interactionCreate', async (interaction) => {
        if (!interaction.isChatInputCommand()) return;

        if (!isOwner(interaction.user.id)) {
            return interaction.reply({ content: '⛔ You are not allowed to use whitelist commands.', ephemeral: true });
        }

        const data = getData();
        const name = interaction.commandName;

        try {
            if (name === 'wl-status') {
                const s = statusSnapshot();
                const embed = new EmbedBuilder()
                    .setTitle('Whitelist status')
                    .setColor(s.maintenanceMode ? 0xf59e0b : 0x10b981)
                    .addFields(
                        { name: 'Bot', value: s.user || '—', inline: true },
                        { name: 'Maintenance', value: s.maintenanceMode ? 'ON' : 'OFF', inline: true },
                        { name: 'Pending', value: String(s.pending), inline: true },
                        { name: 'Keys', value: String(s.keys), inline: true },
                        { name: 'Creators', value: String(s.creators), inline: true },
                        { name: 'Places', value: String(s.places), inline: true }
                    );
                return interaction.reply({ embeds: [embed] });
            }

            if (name === 'wl-pending') {
                const list = data.pendingPlaces || [];
                if (!list.length) return interaction.reply('No pending requests.');
                const lines = list.slice(0, 20).map(p =>
                    `• **${p.name || 'Place'}** \`${p.id}\` — key \`${p.key || '?'}\` — ${p.creatorName || p.creatorId || '?'}`
                );
                return interaction.reply({ content: lines.join('\n'), ephemeral: true });
            }

            if (name === 'wl-approve') {
                const placeId = interaction.options.getString('place_id');
                const keyOpt = interaction.options.getString('key');
                const pending = (data.pendingPlaces || []).find(p => String(p.id) === String(placeId));
                if (!pending && !keyOpt) {
                    return interaction.reply({ content: 'Not found in pending. Pass `key` to force-add.', ephemeral: true });
                }
                const key = keyOpt || pending.key;
                data.whitelist.places = data.whitelist.places || [];
                let place = data.whitelist.places.find(p => String(p.id) === String(placeId));
                if (!place) {
                    place = {
                        id: Number(placeId),
                        name: (pending && pending.name) || `Place ${placeId}`,
                        keys: [],
                        creatorId: pending && pending.creatorId,
                        creatorName: pending && pending.creatorName
                    };
                    data.whitelist.places.push(place);
                }
                place.keys = place.keys || [];
                if (key && !place.keys.some(k => k.key === key)) {
                    place.keys.push({ key, expiresAt: null });
                }
                data.pendingPlaces = (data.pendingPlaces || []).filter(p => String(p.id) !== String(placeId));
                await persist();
                return interaction.reply(`✅ Approved place \`${placeId}\` with key \`${key || '—'}\``);
            }

            if (name === 'wl-reject') {
                const placeId = interaction.options.getString('place_id');
                const before = (data.pendingPlaces || []).length;
                data.pendingPlaces = (data.pendingPlaces || []).filter(p => String(p.id) !== String(placeId));
                await persist();
                return interaction.reply(
                    before === data.pendingPlaces.length
                        ? `Nothing pending for \`${placeId}\``
                        : `🗑 Rejected pending place \`${placeId}\``
                );
            }

            if (name === 'wl-keys') {
                const keys = data.keys || [];
                if (!keys.length) return interaction.reply('No keys registered.');
                const lines = keys.map(k => {
                    const flags = [
                        k.isLocked ? '🔒' : '',
                        k.frozen ? '❄️' : '',
                        k.isAllAccess || String(k.key).toUpperCase() === 'ALL' ? '🌐' : ''
                    ].filter(Boolean).join(' ');
                    return `• \`${k.key}\` ${flags}`;
                });
                return interaction.reply({ content: lines.join('\n'), ephemeral: true });
            }

            if (name === 'wl-add-key') {
                const key = interaction.options.getString('key');
                const allAccess = interaction.options.getBoolean('all_access') || false;
                data.keys = data.keys || [];
                if (data.keys.some(k => k.key === key)) {
                    return interaction.reply({ content: 'Key already exists.', ephemeral: true });
                }
                data.keys.push({ key, isLocked: false, frozen: false, isAllAccess: allAccess });
                await persist();
                return interaction.reply(`✅ Added key \`${key}\`${allAccess ? ' (ALL access)' : ''}`);
            }

            if (name === 'wl-freeze-key') {
                const key = interaction.options.getString('key');
                const keyObj = (data.keys || []).find(k => k.key === key);
                if (!keyObj) return interaction.reply({ content: 'Key not found.', ephemeral: true });
                keyObj.frozen = !keyObj.frozen;
                await persist();
                return interaction.reply(`${keyObj.frozen ? '❄️ Frozen' : '✅ Unfrozen'} key \`${key}\``);
            }

            if (name === 'wl-maintenance') {
                const state = interaction.options.getString('state');
                data.maintenanceMode = state === 'on';
                await persist();
                return interaction.reply(`Maintenance is now **${data.maintenanceMode ? 'ON' : 'OFF'}**`);
            }

            if (name === 'wl-stats') {
                const stats = data.stats || {};
                const embed = new EmbedBuilder()
                    .setTitle('Usage stats')
                    .setColor(0x38bdf8)
                    .addFields(
                        { name: 'Total', value: String(stats.total || 0), inline: true },
                        { name: 'Allowed', value: String(stats.allowed || 0), inline: true },
                        { name: 'Denied', value: String(stats.denied || 0), inline: true }
                    );
                const byKey = stats.byKey || {};
                const top = Object.entries(byKey)
                    .sort((a, b) => ((b[1].allowed || 0) - (a[1].allowed || 0)))
                    .slice(0, 8)
                    .map(([k, v]) => `\`${k}\` ✅${v.allowed || 0} ❌${v.denied || 0}`)
                    .join('\n') || '—';
                embed.addFields({ name: 'Top keys', value: top });
                return interaction.reply({ embeds: [embed] });
            }

            if (name === 'wl-lookup') {
                const type = interaction.options.getString('type');
                const id = interaction.options.getString('id');
                const item = ((data.whitelist && data.whitelist[type]) || []).find(x => String(x.id) === String(id));
                if (!item) return interaction.reply({ content: 'Not found on whitelist.', ephemeral: true });
                const keys = (item.keys || []).map(k => {
                    const f = k.frozen ? '❄️' : '';
                    const e = k.expiresAt ? ` exp=${new Date(k.expiresAt).toISOString()}` : '';
                    return `\`${k.key}\`${f}${e}`;
                }).join(', ') || '—';
                return interaction.reply({
                    content: `**${item.name || type}** (\`${item.id}\`)\nFrozen: ${item.frozen ? 'yes' : 'no'}\nKeys: ${keys}`,
                    ephemeral: true
                });
            }
        } catch (e) {
            console.error('[discord-bot] command error:', e);
            if (interaction.replied || interaction.deferred) {
                return interaction.followUp({ content: 'Error: ' + (e.message || e), ephemeral: true });
            }
            return interaction.reply({ content: 'Error: ' + (e.message || e), ephemeral: true });
        }
    });

    client.on('error', (e) => {
        lastError = e.message || String(e);
        console.error('[discord-bot] client error:', lastError);
    });

    started = true;
    try {
        await client.login(TOKEN);
    } catch (e) {
        lastError = e.message || String(e);
        started = false;
        console.error('[discord-bot] login failed:', lastError);
    }
    return statusSnapshot();
}

module.exports = {
    start,
    status: statusSnapshot,
    getClient: () => client
};
